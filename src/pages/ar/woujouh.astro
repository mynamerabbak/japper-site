---
const pageTitle = "وجوه في الظلام — JAPPER";
const pageDescription =
  "نص تقديمي لعمل Woujouh f Dhlem، حول الظلام، والوجه، وعتامة المستقبل، والتعبير خارج النظرات.";

const shortText = [
  "وُلد Woujouh f Dhlem من رؤية عشتها في تونس: رؤية مستقبل أسود معتم للتونسيين الذين يعيشون في تونس. مستقبل بلا وضوح، وبلا اتجاه بيّن، وبلا إمكانية لمعرفة كيفية التقدم.",
  "انطلاقا من هذه الرؤية، أردت أن أخلق وضعا جسديا قريبا من هذه العتامة. وُضع المشاركون في ظلام كامل، بلا ضوء وبلا صوت. لم يكونوا يعرفون أنهم سيُصوَّرون، ولا كم من الوقت سيبقون في هذا الوضع.",
  "يسعى المشروع إلى التقاط تعبير نادر: تعبير وجه لا ينظر إليه الآخرون، ولا يراقب نفسه. في الظلام الكامل، لا يعود الوجه يستجيب للنظرة الخارجية، ولا يعود يشكّل نفسه أمام مرآة.",
  "من خلال هذه الصور، أسعى إلى ربط تجربة وُلدت في تونس وفي العالم العربي والإسلامي بحالة أوسع: أن يجد الإنسان نفسه أمام مستقبل بلا وضوح، وبلا سيطرة، وبلا اتجاه بيّن. إنها تجربة إنسانية مع عدم اليقين والعتامة.",
];

const longSections = [
  {
    title: "1. الرؤية الأولى",
    paragraphs: [
      "نقطة انطلاق Woujouh f Dhlem ليست فكرة نظرية، بل حدث عشته فعلا في تونس.",
      "كنت أمشي في أحد أحياء تونس، قرب مقابر يهودية ومسيحية. في تلك اللحظة، وأنا مفتوح العينين، ظهرت من الداخل رؤية. ظهر لي مستقبل التونسيين الذين يعيشون في تونس كمستقبل أسود معتم.",
      "لم تكن تلك الرؤية صورة رمزية صُنعت لاحقا. لقد ظهرت في ذهني، في رأسي، في جسدي، كإحساس مادي. ما رأيته لم يكن مجرد مستقبل صعب أو مستقبل مظلم، بل مستقبل مغلق، مستقبل لا يمكن قراءته، مستقبل بلا عمق مرئي وبلا اتجاه واضح.",
      "من هذا الإدراك المباشر وُلدت الرغبة في إعطاء شكل لهذه الرؤية، وجعلها مرئية، وجعلها مادية، وجعلها قابلة للمشاركة مع الآخرين.",
    ],
  },
  {
    title: "2. المستقبل الأسود المعتم",
    paragraphs: [
      "التعبير الذي ظهر في داخلي كان مستقبلًا أسود معتمًا.",
      "لا يتعلق الأمر ببساطة بمستقبل مظلم، أو مستقبل صعب، أو مستقبل غير مؤكد. المستقبل الأسود المعتم هو مستقبل لا يمكن رؤية أي شيء خلفه. يتحول إلى سطح مغلق، بلا شفافية، يمنع كل توقع وكل إسقاط.",
      "في مثل هذا الوضع، لا يعرف المرء إلى أين يذهب، ولا في أي اتجاه يتقدم، ولا حتى كيف يتقدم. بل لا يعرف إن كان التقدم ممكنا أصلا. من استحالة رؤية ما في الأمام وُلد السؤال المركزي: أي مشاعر، وأي تعابير تظهر على وجوه أشخاص وُضعوا أمام مستقبل معتم تماما؟",
    ],
  },
  {
    title: "3. التعبير خارج النظرات",
    paragraphs: [
      "لا يهدف Woujouh f Dhlem أولا إلى إظهار الوجوه. إنه عمل يسأل عمّا يصبح عليه تعبير الوجه عندما يفلت من النظرة.",
      "في الحياة اليومية، تتأثر تعابير وجوهنا غالبا بنظرة الآخرين. عندما ينظر إلينا شخص ما، يتغير وجهنا. حتى إن لم نكن واعين بذلك، فإن الإحساس بأننا مرئيون يؤثر في تعبيرنا.",
      "هناك أيضا تعبير آخر، مثل التعبير الذي يظهر عندما ننظر إلى أنفسنا أمام المرآة. في هذه الحالة نكون محميين من النظرة الخارجية، لكن النظرة تبقى موجودة: نظرتنا نحن إلى أنفسنا. عندئذ يتغير تعبير الوجه بفعل مراقبة الذات.",
      "ما يهمني هنا هو حالة ثالثة: اللحظة التي لا ينظر إلينا فيها أحد، ولا ننظر فيها نحن أيضا إلى أنفسنا. في الظلام الكامل، لا توجد نظرة خارجية ولا نظرة نحو الذات. الوجه لا يجيب أحدا، ولا يشكل نفسه أمام مرآة.",
      "عندها يصبح السؤال: في هذا الوضع، أي تعبير يظهر على الوجه؟",
      "ما يحاول العمل التقاطه هو هذا التعبير النادر، الذي يكاد يستحيل رؤيته. تعبير يولد في الظلام الكامل. حالة يكون فيها الوجه موجودا، لكنه غير منظور إليه. حتى نحن أنفسنا نادرا ما تتاح لنا فرصة رؤية تعبير وجوهنا في الظلام الكامل.",
    ],
  },
  {
    title: "4. الطريقة",
    paragraphs: [
      "لإنجاز هذا العمل، حاولت أن أخلق وضعا أقرب ما يكون إلى فكرة مستقبل أسود معتم.",
      "وُضع المشاركون في فضاء بلا أي ضوء وبلا أي صوت. لم يكونوا يعرفون أنهم يُصوَّرون، ولم يعرفوا كم من الوقت سيبقون في ذلك الظلام. لذلك لم يكن الهدف أن أطلب منهم اتخاذ وضعية، بل خلق شروط مادية قريبة من الظلام الكامل.",
      "في هذا الوضع، لا يعود الوجه يستجيب لنظرة الآخرين، ولا يعود الشخص قادرا على رؤية نفسه. التعبير الذي يظهر هناك ينتمي إلى حالة خاصة جدا: لحظة بلا نظرة خارجية، بلا مرآة، بلا مرئية.",
      "تحاول الفوتوغرافيا هنا أن تصل بين عنصرين متناقضين: التعبير الإنساني، والعتامة السوداء التي تمنع عادة رؤية ذلك التعبير.",
      "يمكن صياغة السؤال المركزي لهذه الطريقة كما يلي.",
    ],
    quote: "كيف يمكن جعل التعبير يظهر من دون محو الظلام؟",
  },
  {
    title: "5. السياق والمشاركة",
    paragraphs: [
      "يندرج هذا العمل في سياق تونس بعد ثورة 2011. أنهت هذه الثورة أكثر من عشرين سنة من الحكم السلطوي. لم يقدها حزب سياسي، ولا الجيش، ولا أيديولوجيا محددة. لقد وُلدت من حركة مدنية واسعة حملها أشخاص أرادوا إنهاء الدكتاتورية، وقمع حرية التعبير، والفساد، واللامساواة، والظلم الاجتماعي.",
      "مقارنة بعمليات أخرى لإسقاط السلطة، كانت هذه الثورة في جزء كبير منها غير عنيفة. لم يصدر العنف عن الحركة الديمقراطية نفسها، بل عن النظام الذي حاول قمعها. أرى أن هذه النقطة مهمة لأنها تخالف عددا من الصور السائدة اليوم عن العرب والمسلمين.",
      "في البداية، حظيت هذه الثورة بإشادة واسعة، خصوصا في البلدان الغربية، بوصفها حركة ديمقراطية ومدنية. لقد فتحت أملا كبيرا، ليس في تونس فقط، بل في عدة بلدان عربية وإسلامية. وأصبحت نقطة انطلاق الربيع العربي، أي سلسلة من الحركات ضد الدكتاتورية والسلطوية.",
      "لكن النظرة الخارجية تغيرت تدريجيا. فوسائل الإعلام، وخصوصا الغربية منها، التي أشادت في البداية بهذا الصعود الديمقراطي، ركزت لاحقا بشكل كبير على عدم الاستقرار والعنف والإرهاب. ومن خلال هذا التركيز، دُفعت الحركات المدنية، والنضالات من أجل الديمقراطية، والأشخاص الذين عملوا من أجل الحرية في البلدان العربية والإسلامية، في كثير من الأحيان إلى الخلفية.",
      "كما عزز هذا التحول في الخطاب صورة العرب والمسلمين كأشخاص خطرين وعنيفين. ما أريد تأكيده هنا هو أن العرب والمسلمين ليسوا أكثر خطرا أو أكثر عنفا من شعوب أخرى، أو حضارات أخرى، أو أديان أخرى.",
      "يتشكل هذا العمل في المسافة بين الأمل الديمقراطي الأولي والمسار الذي يصبح فيه المستقبل تدريجيا مظلما ومعتمًا. ينطلق من رؤية عشتها في تونس، لكنه يتردد أيضا مع أشخاص في بلدان عربية وإسلامية يواجهون الحرب والعنف والأزمات ومستقبلا لا يستطيعون التحكم فيه ولا رؤيته مسبقا.",
      "من خلال هذه الصور، أحاول أن أصل عالما قد يبدو بعيدا عن اليابان بوضع يمكن لكثير من الناس فهمه: الوقوف أمام مستقبل بلا وضوح، مستقبل لا يمكن التحكم فيه، مستقبل بلا اتجاه واضح. ما يبدأ في تونس وفي العالم العربي والإسلامي يمكن أن يتردد في أماكن أخرى، لا بوصفه واقعا أجنبيا، بل بوصفه تجربة إنسانية مع عدم اليقين والعتامة.",
    ],
  },
];
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="stylesheet" href="/style.css" />
  </head>

  <body class="woujouhPage">
    <nav class="woujouhNav" aria-label="تنقل بسيط">
      <div class="woujouhNavGroup">
        <a href="/works">Works</a>
        <a href="/">Home</a>
      </div>
      <div class="woujouhNavGroup" aria-label="اللغات">
        <a href="/woujouh">FR</a>
        <a href="/en/woujouh">EN</a>
        <a href="/jp/woujouh">JP</a>
        <a href="/ar/woujouh" aria-current="page">AR</a>
      </div>
    </nav>

    <main class="woujouhMain">
      <header class="woujouhHero">
        <h1>
          <span lang="ar" dir="rtl">وجوه في الظلام</span>
          <span lang="en" dir="ltr">Woujouh f Dhlem</span>
          <span lang="ja" dir="ltr">暗闇の中の表情</span>
          <span lang="en" dir="ltr">Faces in the Obscurity</span>
        </h1>
      </header>

      <section class="woujouhSection" aria-labelledby="short-text">
        <h2 id="short-text">النص القصير</h2>
        <div class="woujouhText">
          {shortText.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </section>

      <section class="woujouhSection" aria-labelledby="long-text">
        <h2 id="long-text">النص الطويل</h2>

        {longSections.map((section) => (
          <article class="woujouhLongSection">
            <h3>{section.title}</h3>
            <div class="woujouhText">
              {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
              {section.quote && <blockquote>{section.quote}</blockquote>}
            </div>
          </article>
        ))}
      </section>
    </main>

    <style>
      :global(html) {
        background: #000;
      }

      :global(body.woujouhPage) {
        min-height: 100vh;
        margin: 0;
        background:
          radial-gradient(circle at 50% 0%, rgba(105, 13, 18, 0.2), transparent 34rem),
          linear-gradient(180deg, #050505 0%, #000 34rem, #020202 100%);
        color: #f3efe8;
        font-family: sans-serif;
        overflow-x: hidden;
      }

      .woujouhNav {
        position: fixed;
        top: 18px;
        right: 18px;
        z-index: 20;
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-start;
        gap: 10px;
        direction: ltr;
      }

      .woujouhNavGroup {
        display: flex;
        gap: 10px;
      }

      .woujouhNav a {
        color: #f3efe8;
        text-decoration: none;
        border: 1px solid rgba(243, 239, 232, 0.3);
        border-radius: 999px;
        padding: 8px 13px;
        font-size: 13px;
        line-height: 1;
        background: rgba(0, 0, 0, 0.48);
      }

      .woujouhNav a:hover,
      .woujouhNav a:focus-visible,
      .woujouhNav a[aria-current="page"] {
        border-color: rgba(243, 239, 232, 0.75);
      }

      .woujouhMain {
        width: min(100% - 40px, 760px);
        margin: 0 auto;
        padding: 112px 0 96px;
      }

      .woujouhHero {
        padding: 72px 0 86px;
      }

      .woujouhHero h1 {
        display: grid;
        gap: 18px;
        margin: 0;
        max-width: 14ch;
        color: #fffaf2;
        font-size: clamp(42px, 11vw, 82px);
        font-weight: 400;
        line-height: 1.02;
      }

      .woujouhHero h1 span {
        display: block;
      }

      .woujouhHero h1 span:first-child {
        color: #c94b4b;
      }

      .woujouhHero h1 span:not(:first-child) {
        color: rgba(243, 239, 232, 0.68);
        font-size: 0.44em;
        line-height: 1.25;
      }

      .woujouhSection {
        margin-top: 86px;
        padding-top: 42px;
        border-top: 1px solid rgba(243, 239, 232, 0.14);
      }

      .woujouhSection h2 {
        margin: 0 0 32px;
        color: #c94b4b;
        font-size: 15px;
        font-weight: 400;
        letter-spacing: 0.13rem;
        text-transform: uppercase;
      }

      .woujouhText {
        display: grid;
        gap: 28px;
      }

      .woujouhText p,
      .woujouhText blockquote {
        margin: 0;
        max-width: 66ch;
        color: rgba(243, 239, 232, 0.84);
        font-size: clamp(17px, 4vw, 20px);
        line-height: 1.84;
      }

      .woujouhText blockquote {
        padding: 22px 24px 22px 0;
        border-right: 2px solid #c94b4b;
        color: #fffaf2;
        font-size: clamp(19px, 4.4vw, 24px);
      }

      .woujouhLongSection {
        margin-top: 62px;
      }

      .woujouhLongSection h3 {
        margin: 0 0 18px;
        color: #fffaf2;
        font-size: clamp(24px, 7vw, 34px);
        font-weight: 400;
        line-height: 1.15;
      }

      @media (max-width: 640px) {
        .woujouhNav {
          top: 14px;
          right: 14px;
          left: 14px;
        }

        .woujouhMain {
          width: min(100% - 32px, 760px);
          padding: 86px 0 72px;
        }

        .woujouhHero {
          padding: 56px 0 66px;
        }

        .woujouhSection {
          margin-top: 68px;
          padding-top: 34px;
        }
      }
    </style>
  </body>
</html>
